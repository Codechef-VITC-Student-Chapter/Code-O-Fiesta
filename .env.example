JUDGE0_API_URL=http://your-judge0-url:2358
JUDGE0_AUTH_TOKEN=your_auth_token_here

# Mongo sockets per instance. Real total = (concurrent instances x this).
# Default 10 if unset. Raise only if you see pool-exhaustion timeouts.
MONGODB_MAX_POOL_SIZE=10

# Outgoing email (participant credentials). Any SMTP provider works.
# Gmail: smtp.gmail.com / 587 with an App Password. Port 465 => SMTP_SECURE=true.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Hackday <no-reply@example.com>"
# Public URL of the site, used for the login link in emails (no trailing slash).
APP_URL=https://your-site.example.com
